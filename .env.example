DB_OWNER_USER=techforce_owner
DB_OWNER_PASSWORD=owner_password
DB_APP_USER=techforce_app
DB_APP_PASSWORD=app_password
DB_NAME=techforce
DB_HOST=localhost
DB_PORT=5433

# Application connects as the non-superuser app role, not the owner role.
DATABASE_URL=postgresql+psycopg://techforce_app:app_password@localhost:5433/techforce

# Alembic connects as the owner role, since migrations need DDL rights.
ALEMBIC_DATABASE_URL=postgresql+psycopg://techforce_owner:owner_password@localhost:5433/techforce
